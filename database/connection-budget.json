{
  "server": {
    "max_connections": 15,
    "superuser_reserved_connections": 3,
    "reserved_connections": 0
  },
  "operator_allowance": 1,
  "migration_allowance": 1,
  "roles": {
    "market_scanner_writer": 3,
    "market_scanner_reader": 1,
    "momentum_sessions_writer": 1,
    "momentum_results_writer": 2,
    "momentum_results_reader": 1,
    "litellm": 2
  },
  "consumers": {
    "scanner": {
      "roles": [
        "market_scanner_writer"
      ],
      "active": 2,
      "admission": 1
    },
    "scanner_reader": {
      "roles": [
        "market_scanner_reader"
      ],
      "active": 1,
      "admission": 0
    },
    "momentum": {
      "roles": [
        "momentum_sessions_writer",
        "momentum_results_writer"
      ],
      "active": 2,
      "admission": 1
    },
    "momentum_reader": {
      "roles": [
        "momentum_results_reader"
      ],
      "active": 1,
      "admission": 0
    },
    "litellm_admin_and_gateway": {
      "roles": [
        "litellm"
      ],
      "active": 2,
      "admission": 0
    }
  },
  "release_mode": "drain-before-replace",
  "provider_allowance": 1,
  "migration_mode": "offline",
  "runtimes": [
    {
      "consumer": "scanner",
      "file": "infra/market-scanner/market_scanner.tf",
      "resource": "google_cloud_run_v2_service.scanner",
      "instances": 1,
      "connections": 2
    },
    {
      "consumer": "scanner",
      "file": "infra/market-scanner/market_scanner_job.tf",
      "resource": "google_cloud_run_v2_job.daily_scan",
      "instances": 1,
      "connections": 2
    },
    {
      "consumer": "scanner_reader",
      "file": "infra/reader/main.tf",
      "resource": "google_cloud_run_v2_service.reader",
      "instances": 1,
      "connections": 1
    },
    {
      "consumer": "momentum",
      "file": "infra/momentum/main.tf",
      "resource": "google_cloud_run_v2_job.analysis",
      "instances": 1,
      "connections": 2
    },
    {
      "consumer": "momentum_reader",
      "file": "infra/momentum-api/main.tf",
      "resource": "google_cloud_run_v2_service.reader",
      "instances": 1,
      "connections": 1
    },
    {
      "consumer": "litellm_admin_and_gateway",
      "file": "infra/litellm/service.tf",
      "resource": "google_cloud_run_v2_service.litellm",
      "instances": 1,
      "connections": 1
    },
    {
      "consumer": "litellm_admin_and_gateway",
      "file": "infra/litellm/gateway.tf",
      "resource": "google_cloud_run_v2_service.gateway",
      "instances": 1,
      "connections": 1
    },
    {
      "consumer": "migration",
      "file": "infra/litellm/migrations.tf",
      "resource": "google_cloud_run_v2_job.migrations",
      "instances": 1,
      "connections": 1
    }
  ]
}
