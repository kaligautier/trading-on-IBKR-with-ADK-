# Local development: no credentials or external services needed.
MCP_TRANSPORT=stdio
MCP_ENVIRONMENT=local
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_LOG_LEVEL=INFO
# Log tool arguments; disable when tool inputs contain sensitive data.
MCP_LOG_TOOL_ARGUMENTS=true
MCP_LOG_MAX_PAYLOAD_LENGTH=1000
MCP_AUTH_MODE=none

# HTTP with externally issued JWTs (RS256):
# MCP_TRANSPORT=http
# MCP_ENVIRONMENT=production
# MCP_HOST=0.0.0.0
# MCP_ALLOWED_HOSTS=["mcp.example.com","127.0.0.1"]
# MCP_AUTH_MODE=jwt
# MCP_JWT_JWKS_URI=https://identity.example.com/.well-known/jwks.json
# MCP_JWT_ISSUER=https://identity.example.com/
# MCP_JWT_AUDIENCE=deepcopy-mcp
# MCP_REQUIRED_SCOPES=["mcp:access"]

# Optional compatibility transforms for clients that only support tools.
MCP_RESOURCES_AS_TOOLS=false
MCP_PROMPTS_AS_TOOLS=false

# Deepcopy API (apps/backend/deepcopy-api); configure both URL and token.
# Loopback HTTP is accepted in local mode only. The API does not check the
# token yet; it is sent as a bearer token for when it does.
MCP_DEEPCOPY_API__BASE_URL=http://127.0.0.1:8000/
MCP_DEEPCOPY_API__TOKEN=replace-with-deepcopy-api-token
# The IBKR gateway can be slow on its first calls.
MCP_DEEPCOPY_API__REQUEST_TIMEOUT_SECONDS=20
MCP_DEEPCOPY_API__READ_TIMEOUT_SECONDS=15
