  "info": {
    "description": "Private read-only Momentum catalogue. UTC dates/timestamps; finite JSON. Lists are ordered by created_at DESC, id DESC, with filter-bound keyset tokens and no snapshot guarantee under concurrent updates. Latest selects one winner per ticker before rating filters. Unknown ticker returns an empty page. GET/HEAD bodies and duplicate or unknown query parameters are rejected. Error types: https://github.com/kaligautier/trading-on-IBKR-with-ADK-/blob/main/apps/backend/momentum-api/README.md#invalid-argument, invalid-request, invalid-token, not-found, method-not-allowed, not-acceptable, precondition-failed, invalid-stored-data, configuration-error, store-unavailable, internal-error, not-implemented",
    "title": "Momentum consultation API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
