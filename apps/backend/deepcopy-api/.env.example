# Deepcopy API - Environment Variables
# Copy this file to .env and fill in your values

# Google Cloud Platform (required for Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=europe-west1

# IBKR Client Portal gateway, started and signed in by an operator
# (see apps/backend/ibkr-gateway/compose.local.yml)
IBKR_GATEWAY_URL=https://localhost:5055/v1/api
# The local gateway uses a self-signed certificate
IBKR_GATEWAY_VERIFY_TLS=false
IBKR_GATEWAY_TIMEOUT_SECONDS=20

# Application
APP_NAME="Deepcopy API"
PROJECT_NAME="deepcopy-api"
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Agent
AGENT_NAME=deepcopy_agent
MODEL=gemini-2.5-flash
USER_ID=api_user
