GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=eu
MODEL=gemini-3.8-flash
RESEARCHER_THINKING_LEVEL=MEDIUM
SYNTHESIZER_THINKING_LEVEL=LOW
MARKET_SCANNER_DATABASE_URL=postgresql://market_scanner_writer:change-me@127.0.0.1:55432/scanner
DATABASE_SCHEMA=market_scanner
DATABASE_POOL_SIZE=1
DATABASE_POOL_TIMEOUT=30
# Configure this before exposing the execution API beyond localhost.
MARKET_SCANNER_TOKEN=local-development-only
# Set exact origins when accessing a remote ADK server through a local proxy.
ADK_ALLOW_ORIGINS=[]
LOG_LEVEL=INFO

# Optional HTTP trigger target; requires Cloud Run Job invocation permission.
MARKET_SCANNER_JOB=
