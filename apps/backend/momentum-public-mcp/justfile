default:
    @just --list

sync:
    uv sync --frozen --dev

test:
    uv run --frozen pytest -q

lint:
    uv run --frozen ruff check src tests scripts
    uv run --frozen ruff format --check src tests scripts

test-http:
    uv run --frozen python scripts/simulation.py

verify-live url:
    uv run --frozen python scripts/verify_live.py '{{url}}'

check: test lint

run:
    uv run --frozen momentum-public-mcp

# Start Momentum (8000), Market Scanner (8003), and MCP (8080).
up:
    uv run --frozen python scripts/local_stack.py

# Start only the two APIs when MCP is already running separately.
apis:
    uv run --frozen python scripts/local_stack.py --apis-only
