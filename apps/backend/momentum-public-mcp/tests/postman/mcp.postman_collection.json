        "url": "{{mcpUrl}}/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": \"Discovery\",\n  \"method\": \"server/discover\",\n  \"params\": {\n    \"_meta\": {\n      \"io.modelcontextprotocol/protocolVersion\": \"2026-07-28\",\n      \"io.modelcontextprotocol/clientInfo\": {\n        \"name\": \"postman-contract\",\n        \"version\": \"1\"\n      },\n      \"io.modelcontextprotocol/clientCapabilities\": {}\n    }\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"No protocol session\",()=>pm.expect(pm.response.headers.has(\"Mcp-Session-Id\")).to.equal(false));",
              "const body=pm.response.json();",
              "pm.test(\"Modern protocol\",()=>pm.expect(body.result.supportedVersions).to.include(\"2026-07-28\"));",
              "pm.test(\"Resource and prompt capabilities\",()=>{pm.expect(body.result.capabilities).to.have.property(\"resources\");pm.expect(body.result.capabilities).to.have.property(\"prompts\");});"
            ]
          }
        }
      ]
    },
