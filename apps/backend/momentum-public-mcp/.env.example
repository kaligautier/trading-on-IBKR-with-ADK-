MOMENTUM_API_URL=http://localhost:8000
MARKET_SCANNER_API_URL=http://localhost:8003
MOMENTUM_API_USE_IAM=false
# Set each value to that backend's API_TOKEN for local token authentication.
# Ignored when MOMENTUM_API_USE_IAM=true.
MOMENTUM_API_TOKEN=
MARKET_SCANNER_API_TOKEN=
# Shared with Momentum API for the original suggestion caller signature.
SUGGESTION_HASH_SECRET=replace-with-a-shared-random-secret
TRUSTED_PROXIES=
PORT=8080
# Optional locally; set by Terraform for Cloud Logging trace correlation.
GOOGLE_CLOUD_PROJECT=
# Retain all requests initially; lower only fast successes when volume warrants it.
LOG_SUCCESS_SAMPLE_RATE=1.0
LOG_SLOW_REQUEST_MS=2000
