image                   = "europe-west1-docker.pkg.dev/YOUR_PROJECT/market-scanner/market-scanner-adk@sha256:REPLACE_WITH_DIGEST"
database_secret_version = "1"
invoker_members         = ["user:YOUR_EMAIL"]
litellm_gateway = {
  url         = "https://YOUR_GATEWAY.run.app"
  key_secret  = "litellm-client-scanner"
  key_version = "1"
  network     = "private-services"
  subnetwork  = "cloud-run-egress"
}
