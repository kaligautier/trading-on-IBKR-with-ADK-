meta {
  name: Invalid page size
  type: http
  seq: 10
}

get {
  url: {{momentum_api_base_url}}/v1/analyses?page_size=101
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

script:post-response {
  test("HTTP 400", () => expect(res.getStatus()).to.equal(400));
  test("Private cache policy", () => expect(res.getHeader("Cache-Control")).to.eql("no-store"));
  test("Request ID", () => expect(res.getHeader("Request-ID")).to.match(/^[0-9a-f-]{36}$/));
  test("AIP-193 Status", () => { const e = res.getBody().error; expect(e.code).to.eql(res.getStatus()); expect(e.message).to.be.a("string"); expect(e.status).to.be.a("string"); const info = e.details[0]; expect(info["@type"]).to.eql("type.googleapis.com/google.rpc.ErrorInfo"); expect(info.reason).to.match(/^[A-Z][A-Z0-9_]+[A-Z0-9]$/); expect(info.domain).to.eql("momentum-api.deepcopy.fr"); expect(e.details[1].requestId).to.eql(res.getHeader("Request-ID")); expect(res.getHeader("Content-Type")).to.eql("application/json"); });
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
