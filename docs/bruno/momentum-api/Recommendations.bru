meta {
  name: Recommendations
  type: http
  seq: 6
}

get {
  url: {{momentum_api_base_url}}/v1/recommendations
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

script:post-response {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("Private cache policy", () => expect(res.getHeader("Cache-Control")).to.eql("no-store"));
  test("Request ID", () => expect(res.getHeader("Request-ID")).to.match(/^[0-9a-f-]{36}$/));
  test("Bounded page", () => { const p = res.getBody(); expect(p.items).to.be.an("array"); expect(p.items.length).to.be.at.most(10); expect(p.next_page_token).to.be.a("string"); p.items.forEach(item => { ["user_id", "session_id", "invocation_id"].forEach(key => expect(item).not.to.have.property(key)); }); });
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
