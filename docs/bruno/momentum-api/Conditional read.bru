meta {
  name: Conditional read
  type: http
  seq: 15
}

get {
  url: {{momentum_api_base_url}}/v1/analyses
  body: none
  auth: inherit
}

headers {
  Accept: application/json
  If-None-Match: *
}

script:post-response {
  test("HTTP 304", () => expect(res.getStatus()).to.equal(304));
  test("Private cache policy", () => expect(res.getHeader("Cache-Control")).to.eql("no-store"));
  test("Request ID", () => expect(res.getHeader("Request-ID")).to.match(/^[0-9a-f-]{36}$/));
  test("Bodyless response", () => expect(String(res.getBody() ?? "")).to.eql(""));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
