meta {
  name: Invalid UUID
  type: http
  seq: 9
}

get {
  url: {{momentum_api_base_url}}/v1/analyses/invalid
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

script:post-response {
  test("HTTP 400", () => expect(res.getStatus()).to.equal(400));
  test("Private cache policy", () => expect(res.getHeader("Cache-Control")).to.eql("no-store"));
  test("Request ID", () => expect(res.getHeader("Request-ID")).to.match(/^[0-9a-f-]{36}$/));
  test("Error envelope", () => { const e = res.getBody().error; expect(e.code).to.be.a("string"); expect(e.message).to.be.a("string"); expect(res.getHeader("Content-Type")).to.eql("application/json"); });
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
