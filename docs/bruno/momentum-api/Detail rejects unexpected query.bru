meta {
  name: Detail rejects unexpected query
  type: http
  seq: 18
}

get {
  url: {{momentum_api_base_url}}/v1/analyses/{{analysis_id}}?unexpected=1
  body: none
  auth: inherit
}

headers {
  Accept: application/json, application/problem+json
}

script:post-response {
  test("HTTP 400", () => expect(res.getStatus()).to.equal(400));
  test("Private cache policy", () => expect(res.getHeader("Cache-Control")).to.eql("no-store"));
  test("Problem code", () => expect(res.getBody().code).to.eql("INVALID_ARGUMENT"));
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
