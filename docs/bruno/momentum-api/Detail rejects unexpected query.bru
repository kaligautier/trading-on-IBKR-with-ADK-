meta {
  name: Detail rejects unexpected query
  type: http
  seq: 18
}

get {
  url: {{momentum_api_base_url}}/v1/analyses/{{analysis_id}}?unexpected=1
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

script:post-response {
  test("HTTP 400", () => expect(res.getStatus()).to.equal(400));
  test("Private cache policy", () => expect(res.getHeader("Cache-Control")).to.eql("no-store"));
  test("Error reason", () => { const e = res.getBody().error; expect(e.status).to.eql("INVALID_ARGUMENT"); expect(e.details[0].reason).to.eql("INVALID_ARGUMENT"); });
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
