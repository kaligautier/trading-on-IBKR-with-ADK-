meta {
  name: Unknown analysis
  type: http
  seq: 8
}

get {
  url: {{momentum_api_base_url}}/v1/analyses/ffffffff-ffff-ffff-ffff-ffffffffffff
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

script:post-response {
  test("HTTP 404", () => expect(res.getStatus()).to.equal(404));
  test("Private cache policy", () => expect(res.getHeader("Cache-Control")).to.eql("no-store"));
  test("Request ID", () => expect(res.getHeader("Request-ID")).to.match(/^[0-9a-f-]{36}$/));
  test("AIP-193 Status", () => { const e = res.getBody().error; expect(e.code).to.eql(res.getStatus()); expect(e.message).to.be.a("string"); expect(e.status).to.be.a("string"); const info = e.details[0]; expect(info["@type"]).to.eql("type.googleapis.com/google.rpc.ErrorInfo"); expect(info.reason).to.match(/^[A-Z][A-Z0-9_]+[A-Z0-9]$/); expect(info.domain).to.eql("momentum-api.deepcopy.fr"); expect(e.details[1].requestId).to.eql(res.getHeader("Request-ID")); expect(res.getHeader("Content-Type")).to.eql("application/json"); });
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}

example {
  name: Synthetic example
  
  request: {
    url: {{momentum_api_base_url}}/v1/analyses/ffffffff-ffff-ffff-ffff-ffffffffffff
    method: GET
    mode: none
    headers: {
      Accept: application/json
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: text
      content: '''
        {
          "error": {
            "code": 404,
            "message": "The requested analysis does not exist.",
            "status": "NOT_FOUND",
            "details": [
              {
                "@type": "type.googleapis.com/google.rpc.ErrorInfo",
                "reason": "ANALYSIS_NOT_FOUND",
                "domain": "momentum-api.deepcopy.fr",
                "metadata": {}
              }
            ]
          }
        }
      '''
    }
  }
}
