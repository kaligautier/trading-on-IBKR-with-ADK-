meta {
  name: Latest
  type: http
  seq: 5
}

get {
  url: {{momentum_api_base_url}}/v1/analyses/latest?page_size=20
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

script:post-response {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("Private cache policy", () => expect(res.getHeader("Cache-Control")).to.eql("no-store"));
  test("Request ID", () => expect(res.getHeader("Request-ID")).to.match(/^[0-9a-f-]{36}$/));
  test("Bounded page", () => { const p = res.getBody(); expect(p.items).to.be.an("array"); expect(p.items.length).to.be.at.most(20); expect(p.next_page_token).to.be.a("string"); p.items.forEach(item => { ["user_id", "session_id", "invocation_id"].forEach(key => expect(item).not.to.have.property(key)); }); });
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}

example {
  name: Synthetic example
  
  request: {
    url: {{momentum_api_base_url}}/v1/analyses/latest?page_size=20
    method: GET
    mode: none
    headers: {
      Accept: application/json
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "items": [
            {
              "id": "00000000-0000-0000-0000-000000000001",
              "ticker": "T000",
              "analysis_date": "2026-10-22",
              "created_at": "2026-10-22T12:00:00Z",
              "llm_provider": "synthetic",
              "next_analysis_date": null,
              "rating": null,
              "executive_summary": null,
              "price_target": null,
              "entry_price": null,
              "stop_loss": null,
              "position_size": null,
              "position_size_description": null,
              "time_horizon_months": null,
              "time_horizon_description": null,
              "risk_reward_ratio": null,
              "risk_reward_description": null,
              "trader_action": null,
              "trader_entry": null,
              "trader_stop": null,
              "trader_take_profit": null,
              "close_price": null,
              "rsi": null,
              "rsi_signal": null,
              "trend_direction": null,
              "key_support": null,
              "key_resistance": null,
              "pe_ratio": null,
              "peg_ratio": null,
              "beta": null
            }
          ],
          "next_page_token": ""
        }
      '''
    }
  }
}
