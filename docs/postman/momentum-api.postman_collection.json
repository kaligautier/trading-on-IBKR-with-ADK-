{
  "info": {
    "name": "Momentum consultation API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Private read-only Momentum v1; run against a known synthetic analysis."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "momentum_api_base_url",
      "value": "https://localhost:8002"
    },
    {
      "key": "api_token",
      "value": ""
    },
    {
      "key": "analysis_id",
      "value": "00000000-0000-0000-0000-000000000001"
    }
  ],
  "item": [
    {
      "name": "Liveness",
      "request": {
        "method": "GET",
        "url": "{{momentum_api_base_url}}/health",
        "header": [
          {
            "key": "Accept",
            "value": "application/json, application/problem+json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Private cache policy\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "pm.test(\"Request ID\", () => pm.expect(pm.response.headers.get(\"Request-ID\")).to.match(/^[0-9a-f-]{36}$/));"
            ]
          }
        }
      ]
    },
