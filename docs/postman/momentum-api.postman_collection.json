            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Private cache policy\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "pm.test(\"Request ID\", () => pm.expect(pm.response.headers.get(\"Request-ID\")).to.match(/^[0-9a-f-]{36}$/));",
              "pm.test(\"Bounded page\", () => { const p = pm.response.json(); pm.expect(p.items).to.be.an(\"array\"); pm.expect(p.items.length).to.be.at.most(20); pm.expect(p.next_page_token).to.be.a(\"string\"); p.items.forEach(item => { [\"user_id\", \"session_id\", \"invocation_id\"].forEach(key => pm.expect(item).not.to.have.property(key)); }); });"
            ]
          }
        }
      ],
